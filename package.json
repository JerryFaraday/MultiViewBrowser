{
  "name": "multiview-browser",
  "version": "0.1.1",
  "private": true,
  "description": "Windows 多网页分屏浏览器",
  "author": "MultiView Browser",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build && node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "electron .",
    "pack": "npm run build && electron-builder --win --dir",
    "dist": "npm run build && electron-builder --win nsis",
    "smoke": "node scripts/smoke.mjs",
    "format": "prettier --write src electron scripts tests package.json tsconfig.json vite.config.ts",
    "format:check": "prettier --check src electron scripts tests package.json tsconfig.json vite.config.ts",
    "smoke:drag": "node scripts/drag-smoke.mjs",
    "version:bump": "node scripts/bump-version.mjs"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "build": {
    "appId": "com.multiviewbrowser.desktop",
    "productName": "MultiView Browser",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/main.cjs",
      "dist-electron/preload.cjs",
      "package.json",
      "dist-electron/media-preload.cjs",
      "dist-electron/volume-preload.cjs",
      "dist-electron/volume.html",
      "dist-electron/drag-preload.cjs",
      "dist-electron/drag.html",
      "dist-electron/scale-preload.cjs",
      "dist-electron/scale.html"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "buildVersion": "0.1.1.12",
    "executableName": "MultiViewBrowser"
  },
  "type": "module"
}
